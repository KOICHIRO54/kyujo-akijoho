{
  "name": "名古屋市スポーツ・レクリエーション情報システム",
  "enabled": true,
  "start_url": "https://www.net.city.nagoya.jp/sporec/index.html",
  "pages": 1,
  "_note": "種目「野球（硬式）」で選べるのはパロマ瑞穂野球場のみ（熱田は対象外）。期間「指定日以降の土日祝」で約1か月分が1画面に出る。",
  "common_steps": [
    {
      "do": "goto",
      "url": "https://www.net.city.nagoya.jp/sporec/index.html"
    },
    {
      "do": "click",
      "text": "施設ごとの検索・予約"
    }
  ],
  "fields": {
    "mizuho": {
      "steps": [
        {
          "do": "select",
          "selector": "select[name=syumoku]",
          "label": "野球（硬式）"
        },
        {
          "do": "select",
          "selector": "select[name=sisetu]",
          "contains": [
            "パロマ瑞穂野球場"
          ]
        },
        {
          "do": "select",
          "selector": "select[name=month]",
          "label": "{MM}"
        },
        {
          "do": "select",
          "selector": "select[name=day]",
          "label": "{DD}"
        },
        {
          "do": "select",
          "selector": "select[name=time]",
          "label": "指定日以降の土日祝"
        },
        {
          "do": "click",
          "text": "照会"
        }
      ]
    }
  },
  "parser": "nagoya_sporec"
}