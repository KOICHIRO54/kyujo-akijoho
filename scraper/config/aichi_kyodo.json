{
  "name": "あいち共同利用型施設予約システム",
  "enabled": true,
  "start_url": "https://www.e-shisetsu.e-aichi.jp/web_info.html",
  "_note": "館選択後の1日表示を、左のカレンダーと同じ関数で日付を切り替えて読む。土日祝のみ60日分。 豊橋市民球場はあいち共同に登録がない（「岩田」で検索しても庭球場のみ）。",
  "common_steps": [
    {
      "do": "goto",
      "url": "https://www.e-shisetsu.e-aichi.jp/web_info.html"
    },
    {
      "do": "click",
      "text": "多機能版"
    },
    {
      "do": "click",
      "text": "施設名から"
    }
  ],
  "fields": {
    "kasugai": {
      "steps": [
        {
          "do": "click",
          "text": "春日井市"
        },
        {
          "do": "fill",
          "selector": "#textKeyword",
          "value": "球場"
        },
        {
          "do": "click",
          "text": "上記の内容で検索する"
        },
        {
          "do": "click_row",
          "row_text": "春日井市民球場",
          "text": "選択"
        }
      ],
      "block": "球場",
      "until": "2026-12-31",
      "_note": "春日井市は令和9年1月利用分から市独自の予約システムに移行するため、あいち共同では12月分まで"
