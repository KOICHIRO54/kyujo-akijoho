{
  "name": "多治見市公共施設予約システム",
  "enabled": true,
  "start_url": "https://www2.pf489.com/tajimi/WebR/",
  "pages": 3,
  "_note": "施設別空き状況（日単位の○△×）を1か月表示で読む。月送りは調整中。",
  "common_steps": [
    {
      "do": "goto",
      "url": "https://www2.pf489.com/tajimi/WebR/"
    },
    {
      "do": "click",
      "text": "施設名から探す"
    },
    {
      "do": "fill",
      "selector": "#shisetsuNameTxt",
      "value": "球場"
    },
    {
      "do": "click",
      "selector": "#btnSearchShisetsuName"
    }
  ],
  "fields": {
    "tajimi": {
      "steps": [
        {
          "do": "click",
          "text": "野球場・運動広場"
        },
        {
          "do": "click",
          "text": "次へ進む"
        },
        {
          "do": "click",
          "selector": "label[for=radioPeriod1month]",
          "optional": true
        },
        {
          "do": "click",
          "selector": "#btnHyoji",
          "optional": true
        }
      ],
      "block": "ＴＹＫ球場"
    }
  },
  "parser": "pf489",
  "next": {
    "do": "click",
    "selector": "a.nextMonth, a[title*='次'], .calendar-next, a:has(i.fa-chevron-right)",
    "optional": true
  }
}