{
  "name": "一宮市スポーツ・公園施設予約システム",
  "enabled": true,
  "start_url": "https://www.11489.jp/Ichinomiya/Web/Home/WgR_ModeSelect",
  "pages": 3,
  "_note": "施設別空き状況（日単位の○△×）を1か月表示で読む。月送りは調整中。",
  "common_steps": [
    {
      "do": "goto",
      "url": "https://www.11489.jp/Ichinomiya/Web/Home/WgR_ModeSelect"
    },
    {
      "do": "click",
      "text": "施設名から探す"
    },
    {
      "do": "fill",
      "selector": "#shisetsuNameTxt",
      "value": "平島"
    },
    {
      "do": "click",
      "selector": "#btnSearchShisetsuName"
    }
  ],
  "fields": {
    "ichinomiya": {
      "steps": [
        {
          "do": "click",
          "text": "平島公園野球場"
        },
        {
          "do": "click",
          "text": "次へ進む"
        },
        {
          "do": "click",
          "selector": "label[for=radioPeriod1month]",
          "optional": true
        },
        {
          "do": "click",
          "selector": "#btnHyoji",
          "optional": true
        }
      ],
      "block": "野球場",
      "drill": "pf489_times"
    }
  },
  "parser": "pf489",
  "next": {
    "do": "click",
    "selector": "a.nextMonth, a[title*='次'], .calendar-next, a:has(i.fa-chevron-right)",
    "optional": true
  }
}