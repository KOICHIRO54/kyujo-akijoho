{
  "name": "小牧市公共施設予約システム",
  "enabled": true,
  "start_url": "https://www.pf489.com/komaki/webR/",
  "pages": 3,
  "_note": "施設別空き状況（日単位の○△×）を1か月表示で読み、土日祝の○△の日は時間帯別空き状況まで進んで1時間ごとに読む。",
  "common_steps": [
    {
      "do": "goto",
      "url": "https://www.pf489.com/komaki/webR/"
    },
    {
      "do": "click",
      "text": "施設名から探す"
    },
    {
      "do": "fill",
      "selector": "#shisetsuNameTxt",
      "value": "総合運動場"
    },
    {
      "do": "click",
      "selector": "#btnSearchShisetsuName"
    }
  ],
  "fields": {
    "komaki": {
      "steps": [
        {
          "do": "click",
          "text": "総合運動場（野球場）"
        },
        {
          "do": "click",
          "text": "次へ進む"
        },
        {
          "do": "click",
          "selector": "label[for=radioPeriod1month]",
          "optional": true
        },
        {
          "do": "click",
          "selector": "#btnHyoji",
          "optional": true
        }
      ],
      "block": "野球場",
      "drill": "pf489_times",
      "merge": true
    }
  },
  "parser": "pf489",
  "next": {
    "do": "click",
    "selector": "a.nextMonth, a[title*='次'], .calendar-next, a:has(i.fa-chevron-right)",
    "optional": true
  }
}